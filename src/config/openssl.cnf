# OpenSSL configuration for PQC Benchmarking Suite
# This configuration enables oqs-provider for post-quantum algorithms

openssl_conf = openssl_init

[openssl_init]
providers = provider_sect
ssl_conf = ssl_sect

[provider_sect]
# Default provider for classical algorithms
default = default_sect
# OQS provider for post-quantum algorithms
oqsprovider = oqsprovider_sect

[default_sect]
activate = 1

[oqsprovider_sect]
activate = 1
# Uncomment and modify if oqs-provider is installed in a non-standard location
# module = /path/to/oqsprovider.so

# TLS configuration preferences
# Note: These are defaults; the TLS script overrides with -groups flag
[ssl_sect]
system_default = system_default_sect

[system_default_sect]
# Groups for key exchange (KEMs) - PQC hybrids preferred
Groups = x25519_mlkem768:x25519:mlkem768:p256_mlkem512

# Signature algorithms for certificate verification
SignatureAlgorithms = mldsa65:falcon512:ed25519:ecdsa
